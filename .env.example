# Copy to .env and chmod 600 it. Never commit the real one.

# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Friends must type this to register. Set it, share it in your group chat,
# and clear it once everyone has signed up.
INVITE_CODE=

# Game night times are entered and displayed in this zone.
APP_TIMEZONE=America/Chicago

# 1 only on your own machine.
FLASK_DEBUG=0
